{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://github.com/timmyagentic/awesome-agent-app-features/features/feature.schema.json",
  "title": "Agent app feature manifest",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "schema",
    "id",
    "name",
    "maturity",
    "contract",
    "release_status",
    "since",
    "runtime",
    "package",
    "integration_model",
    "foundation",
    "prerequisites",
    "invariants",
    "integration_steps",
    "verification"
  ],
  "properties": {
    "$schema": { "type": "string" },
    "schema": { "const": 1 },
    "id": { "type": "string", "pattern": "^[a-z][a-z0-9-]*$" },
    "name": { "type": "string", "minLength": 1 },
    "maturity": { "enum": ["mvp", "stable"] },
    "contract": { "const": "v1" },
    "release_status": { "enum": ["unreleased", "released"] },
    "since": {
      "oneOf": [
        { "type": "null" },
        { "type": "string", "pattern": "^v[0-9]+\\.[0-9]+\\.[0-9]+$" }
      ]
    },
    "runtime": {
      "type": "array",
      "minItems": 1,
      "uniqueItems": true,
      "items": { "type": "string", "minLength": 1 }
    },
    "package": { "type": "string", "minLength": 1 },
    "integration_model": { "const": "agent-assisted-code-change" },
    "foundation": {
      "type": "object",
      "additionalProperties": false,
      "required": ["core", "adapters", "host", "excludes"],
      "properties": {
        "core": {
          "type": "array",
          "minItems": 1,
          "uniqueItems": true,
          "items": { "type": "string", "minLength": 1 }
        },
        "adapters": {
          "type": "array",
          "minItems": 1,
          "items": {
            "type": "object",
            "additionalProperties": false,
            "required": ["path", "role"],
            "properties": {
              "path": { "type": "string", "pattern": "^\\./", "minLength": 3 },
              "role": { "type": "string", "minLength": 1 }
            }
          }
        },
        "host": {
          "type": "array",
          "minItems": 1,
          "uniqueItems": true,
          "items": { "type": "string", "minLength": 1 }
        },
        "excludes": {
          "type": "array",
          "minItems": 1,
          "uniqueItems": true,
          "items": { "type": "string", "minLength": 1 }
        }
      }
    },
    "relay": { "type": "string", "minLength": 1 },
    "platforms": {
      "type": "array",
      "uniqueItems": true,
      "items": { "type": "string", "minLength": 1 }
    },
    "prerequisites": {
      "type": "array",
      "minItems": 1,
      "items": { "type": "string", "minLength": 1 }
    },
    "invariants": {
      "type": "array",
      "minItems": 1,
      "items": { "type": "string", "minLength": 1 }
    },
    "integration_steps": {
      "type": "array",
      "minItems": 1,
      "items": { "type": "string", "minLength": 1 }
    },
    "verification": {
      "type": "array",
      "minItems": 1,
      "items": { "type": "string", "minLength": 1 }
    }
  },
  "allOf": [
    {
      "if": { "properties": { "release_status": { "const": "unreleased" } } },
      "then": { "properties": { "since": { "type": "null" } } }
    },
    {
      "if": { "properties": { "release_status": { "const": "released" } } },
      "then": { "properties": { "since": { "type": "string" } } }
    }
  ]
}
