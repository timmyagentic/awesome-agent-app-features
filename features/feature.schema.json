{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://github.com/timmyagentic/awesome-agent-app-features/features/feature.schema.json",
  "title": "Agent app feature manifest",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "schema",
    "id",
    "name",
    "maturity",
    "contract",
    "release_status",
    "since",
    "runtime",
    "package",
    "integration_model",
    "delivery",
    "remote_examples",
    "foundation",
    "prerequisites",
    "invariants",
    "integration_steps",
    "lifecycle",
    "verification"
  ],
  "properties": {
    "$schema": { "type": "string" },
    "schema": { "const": 1 },
    "id": { "type": "string", "pattern": "^[a-z][a-z0-9-]*$" },
    "name": { "type": "string", "minLength": 1 },
    "maturity": { "enum": ["mvp", "stable"] },
    "contract": { "const": "v1" },
    "release_status": { "enum": ["unreleased", "released"] },
    "since": {
      "oneOf": [
        { "type": "null" },
        { "type": "string", "pattern": "^v[0-9]+\\.[0-9]+\\.[0-9]+$" }
      ]
    },
    "runtime": {
      "type": "array",
      "minItems": 1,
      "uniqueItems": true,
      "items": { "type": "string", "minLength": 1 }
    },
    "package": { "type": "string", "minLength": 1 },
    "integration_model": { "const": "agent-assisted-code-change" },
    "delivery": {
      "type": "array",
      "minItems": 1,
      "items": {
        "oneOf": [
          {
            "type": "object",
            "additionalProperties": false,
            "required": ["mode", "pin", "module", "minimum_go", "packages"],
            "properties": {
              "mode": { "const": "go-module" },
              "pin": { "const": "resolved-commit" },
              "module": { "const": "github.com/timmyagentic/awesome-agent-app-features" },
              "minimum_go": { "const": "1.25.0" },
              "packages": {
                "type": "array",
                "minItems": 1,
                "uniqueItems": true,
                "items": {
                  "type": "string",
                  "pattern": "^github\\.com/timmyagentic/awesome-agent-app-features(/[a-z][a-z0-9-]*)+$"
                }
              }
            }
          },
          {
            "type": "object",
            "additionalProperties": false,
            "required": ["mode", "pin", "path", "destination"],
            "properties": {
              "mode": { "const": "source-subtree" },
              "pin": { "const": "resolved-commit" },
              "path": {
                "type": "string",
                "pattern": "^[a-z0-9][a-z0-9.-]*(/[a-z0-9][a-z0-9.-]*)*$"
              },
              "destination": { "const": "host-infrastructure" }
            }
          }
        ]
      }
    },
    "remote_examples": {
      "type": "array",
      "minItems": 1,
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": ["id", "mode", "package", "network", "side_effects"],
        "properties": {
          "id": { "type": "string", "pattern": "^[a-z][a-z0-9-]*$" },
          "mode": { "const": "go-run" },
          "package": {
            "type": "string",
            "pattern": "^github\\.com/timmyagentic/awesome-agent-app-features/examples/[a-z][a-z0-9-]*$"
          },
          "network": { "enum": ["none", "optional", "required"] },
          "side_effects": { "enum": ["none", "temporary-files-only"] }
        }
      }
    },
    "foundation": {
      "type": "object",
      "additionalProperties": false,
      "required": ["core", "adapters", "host", "excludes"],
      "properties": {
        "core": {
          "type": "array",
          "minItems": 1,
          "uniqueItems": true,
          "items": { "type": "string", "minLength": 1 }
        },
        "adapters": {
          "type": "array",
          "minItems": 1,
          "items": {
            "type": "object",
            "additionalProperties": false,
            "required": ["path", "role"],
            "properties": {
              "path": { "type": "string", "pattern": "^\\./", "minLength": 3 },
              "role": { "type": "string", "minLength": 1 }
            }
          }
        },
        "host": {
          "type": "array",
          "minItems": 1,
          "uniqueItems": true,
          "items": { "type": "string", "minLength": 1 }
        },
        "excludes": {
          "type": "array",
          "minItems": 1,
          "uniqueItems": true,
          "items": { "type": "string", "minLength": 1 }
        }
      }
    },
    "relay": { "type": "string", "minLength": 1 },
    "platforms": {
      "type": "array",
      "uniqueItems": true,
      "items": { "type": "string", "minLength": 1 }
    },
    "prerequisites": {
      "type": "array",
      "minItems": 1,
      "items": { "type": "string", "minLength": 1 }
    },
    "invariants": {
      "type": "array",
      "minItems": 1,
      "items": { "type": "string", "minLength": 1 }
    },
    "integration_steps": {
      "type": "array",
      "minItems": 1,
      "items": { "type": "string", "minLength": 1 }
    },
    "lifecycle": {
      "type": "object",
      "additionalProperties": false,
      "required": ["inspect", "validate", "refine", "upgrade", "remove"],
      "properties": {
        "inspect": {
          "type": "array",
          "minItems": 1,
          "items": { "type": "string", "minLength": 1 }
        },
        "validate": {
          "type": "array",
          "minItems": 1,
          "items": { "type": "string", "minLength": 1 }
        },
        "refine": {
          "type": "array",
          "minItems": 1,
          "items": { "type": "string", "minLength": 1 }
        },
        "upgrade": {
          "type": "array",
          "minItems": 1,
          "items": { "type": "string", "minLength": 1 }
        },
        "remove": {
          "type": "array",
          "minItems": 1,
          "items": { "type": "string", "minLength": 1 }
        }
      }
    },
    "verification": {
      "type": "object",
      "additionalProperties": false,
      "required": ["remote", "foundation", "host"],
      "properties": {
        "remote": {
          "type": "array",
          "minItems": 1,
          "items": { "type": "string", "minLength": 1 }
        },
        "foundation": {
          "type": "array",
          "minItems": 1,
          "items": { "type": "string", "minLength": 1 }
        },
        "host": {
          "type": "array",
          "minItems": 1,
          "items": { "type": "string", "minLength": 1 }
        }
      }
    }
  },
  "allOf": [
    {
      "if": { "properties": { "release_status": { "const": "unreleased" } } },
      "then": { "properties": { "since": { "type": "null" } } }
    },
    {
      "if": { "properties": { "release_status": { "const": "released" } } },
      "then": { "properties": { "since": { "type": "string" } } }
    }
  ]
}
