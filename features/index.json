{
  "$schema": "./index.schema.json",
  "schema": 1,
  "id": "awesome-agent-app-features",
  "repository": "https://github.com/timmyagentic/awesome-agent-app-features",
  "module": "github.com/timmyagentic/awesome-agent-app-features",
  "contract": "v1",
  "release_status": "released",
  "since": "v1.0.0",
  "integration_model": "remote-agent-assisted-code-change",
  "entrypoint": {
    "path": "features/index.json",
    "discovery_url": "https://raw.githubusercontent.com/timmyagentic/awesome-agent-app-features/main/features/index.json"
  },
  "resolution": {
    "provider": "github",
    "repository": "timmyagentic/awesome-agent-app-features",
    "bootstrap_ref": "main",
    "immutable_ref": "full-commit-sha",
    "required_ci": "CI"
  },
  "delivery": {
    "user_clone_required": false,
    "allowed_modes": ["go-module", "source-subtree"],
    "forbidden": ["user-clone", "git-submodule", "local-replace", "floating-main"]
  },
  "lock": {
    "schema_path": "features/integration-lock.schema.json",
    "host_path": "agent-app-features.lock.json",
    "validator_package": "github.com/timmyagentic/awesome-agent-app-features/cmd/feature-lock"
  },
  "agent_flow": [
    "Resolve main to one full commit SHA and require successful CI.",
    "Read this entry and the selected feature manifest from that same SHA.",
    "Map the feature responsibilities and invariants to the target project.",
    "Apply only the delivery items declared by the feature.",
    "Run remote conformance and the target project's normal verification.",
    "Record source, deliveries, files, checks, and unverified boundaries in the visible lock file, then run the same-commit stateless lock validator."
  ],
  "features": [
    {
      "id": "feedback",
      "manifest": "features/feedback/feature.json",
      "readme": "features/feedback/README.md",
      "contract": "v1"
    },
    {
      "id": "updater",
      "manifest": "features/updater/feature.json",
      "readme": "features/updater/README.md",
      "contract": "v1"
    }
  ]
}
