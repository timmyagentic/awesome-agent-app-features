{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://github.com/timmyagentic/awesome-agent-app-features/features/integration-lock.schema.json",
  "title": "Agent app feature integration lock",
  "type": "object",
  "additionalProperties": false,
  "required": ["schema", "source", "features"],
  "properties": {
    "schema": { "const": 1 },
    "source": {
      "type": "object",
      "additionalProperties": false,
      "required": ["repository", "commit"],
      "properties": {
        "repository": { "const": "timmyagentic/awesome-agent-app-features" },
        "commit": { "type": "string", "pattern": "^(?!0{40}$)[0-9a-f]{40}$" }
      }
    },
    "features": {
      "type": "array",
      "minItems": 1,
      "maxItems": 100,
      "uniqueItems": true,
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": ["id", "contract", "deliveries", "files", "verified_at", "checks", "unverified"],
        "properties": {
          "id": { "type": "string", "pattern": "^[a-z][a-z0-9-]*$" },
          "contract": { "const": "v1" },
          "deliveries": {
            "type": "array",
            "minItems": 1,
            "uniqueItems": true,
            "items": {
              "oneOf": [
                {
                  "type": "object",
                  "additionalProperties": false,
                  "required": ["mode", "source", "target", "version"],
                  "properties": {
                    "mode": { "const": "go-module" },
                    "source": {
                      "type": "string",
                      "pattern": "^github\\.com/timmyagentic/awesome-agent-app-features(/[a-z][a-z0-9-]*)+$"
                    },
                    "target": { "$ref": "#/$defs/go_mod_path" },
                    "version": {
                      "type": "string",
                      "maxLength": 128,
                      "pattern": "^v[0-9]+\\.[0-9]+\\.[0-9]+(?:-[0-9A-Za-z][0-9A-Za-z.-]*)?(?:\\+[0-9A-Za-z][0-9A-Za-z.-]*)?$"
                    }
                  }
                },
                {
                  "type": "object",
                  "additionalProperties": false,
                  "required": ["mode", "source", "target"],
                  "properties": {
                    "mode": { "const": "source-subtree" },
                    "source": { "$ref": "#/$defs/relative_path" },
                    "target": { "$ref": "#/$defs/relative_path" }
                  }
                }
              ]
            }
          },
          "files": {
            "type": "array",
            "minItems": 1,
            "uniqueItems": true,
            "items": { "$ref": "#/$defs/relative_path" }
          },
          "verified_at": { "type": "string", "format": "date-time" },
          "checks": {
            "type": "array",
            "minItems": 1,
            "uniqueItems": true,
            "items": { "type": "string", "minLength": 1, "maxLength": 1000 }
          },
          "unverified": {
            "type": "array",
            "uniqueItems": true,
            "items": { "type": "string", "minLength": 1, "maxLength": 1000 }
          }
        }
      }
    }
  },
  "$defs": {
    "relative_path": {
      "type": "string",
      "maxLength": 512,
      "pattern": "^(?!/)(?!.*(?:^|/)\\.\\.?(/|$))[A-Za-z0-9._-]+(?:/[A-Za-z0-9._-]+)*$"
    },
    "go_mod_path": {
      "allOf": [
        { "$ref": "#/$defs/relative_path" },
        { "type": "string", "pattern": "^(?:[A-Za-z0-9._-]+/)*go\\.mod$" }
      ]
    }
  }
}
