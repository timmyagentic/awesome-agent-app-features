{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://github.com/timmyagentic/awesome-agent-app-features/features/integration-receipt.schema.json",
  "title": "Agent feature host integration receipt",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "schema",
    "schema_path",
    "receipt_path",
    "state",
    "source",
    "feature",
    "host",
    "deliveries",
    "artifacts",
    "invariants",
    "verification",
    "unverified",
    "history",
    "removal",
    "updated_at"
  ],
  "properties": {
    "schema": { "const": 1 },
    "schema_path": { "const": "features/integration-receipt.schema.json" },
    "receipt_path": {
      "type": "string",
      "pattern": "^\\.agent-app-features/[a-z][a-z0-9-]*\\.json$"
    },
    "state": { "enum": ["partial", "active", "removed"] },
    "source": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "repository",
        "resolved_commit",
        "ci_run_url",
        "ci_conclusion",
        "entry_path",
        "manifest_path"
      ],
      "properties": {
        "repository": { "const": "timmyagentic/awesome-agent-app-features" },
        "resolved_commit": { "type": "string", "pattern": "^[0-9a-f]{40}$" },
        "ci_run_url": {
          "type": "string",
          "format": "uri",
          "pattern": "^https://github\\.com/timmyagentic/awesome-agent-app-features/actions/runs/[1-9][0-9]*$"
        },
        "ci_conclusion": { "const": "success" },
        "entry_path": { "const": "features/index.json" },
        "manifest_path": {
          "type": "string",
          "pattern": "^features/[a-z][a-z0-9-]*/feature\\.json$"
        }
      }
    },
    "feature": {
      "type": "object",
      "additionalProperties": false,
      "required": ["id", "contract", "release_status", "since"],
      "properties": {
        "id": { "type": "string", "pattern": "^[a-z][a-z0-9-]*$" },
        "contract": { "const": "v1" },
        "release_status": { "enum": ["unreleased", "released"] },
        "since": {
          "oneOf": [
            { "type": "null" },
            { "type": "string", "pattern": "^v[0-9]+\\.[0-9]+\\.[0-9]+$" }
          ]
        }
      },
      "allOf": [
        {
          "if": { "properties": { "release_status": { "const": "unreleased" } } },
          "then": { "properties": { "since": { "type": "null" } } }
        },
        {
          "if": { "properties": { "release_status": { "const": "released" } } },
          "then": { "properties": { "since": { "type": "string" } } }
        }
      ]
    },
    "host": {
      "type": "object",
      "additionalProperties": false,
      "required": ["root", "runtime", "entry_points", "configuration_keys"],
      "properties": {
        "root": { "const": "." },
        "runtime": {
          "type": "array",
          "minItems": 1,
          "maxItems": 10,
          "uniqueItems": true,
          "items": { "type": "string", "minLength": 1, "maxLength": 80 }
        },
        "entry_points": {
          "type": "array",
          "maxItems": 50,
          "uniqueItems": true,
          "items": { "type": "string", "minLength": 1, "maxLength": 160 }
        },
        "configuration_keys": {
          "type": "array",
          "maxItems": 100,
          "uniqueItems": true,
          "items": {
            "type": "string",
            "maxLength": 160,
            "pattern": "^[A-Za-z][A-Za-z0-9_.-]*$"
          }
        }
      }
    },
    "deliveries": {
      "type": "array",
      "minItems": 1,
      "maxItems": 20,
      "items": {
        "oneOf": [
          {
            "type": "object",
            "additionalProperties": false,
            "required": ["mode", "source", "target", "resolved_version"],
            "properties": {
              "mode": { "const": "go-module" },
              "source": {
                "type": "string",
                "pattern": "^github\\.com/timmyagentic/awesome-agent-app-features(/[a-z][a-z0-9-]*)+$"
              },
              "target": { "const": "go.mod" },
              "resolved_version": {
                "type": "string",
                "pattern": "^(v[0-9]+\\.[0-9]+\\.[0-9]+|v0\\.0\\.0-[0-9]{14}-[0-9a-f]{12})$"
              }
            }
          },
          {
            "type": "object",
            "additionalProperties": false,
            "required": ["mode", "source", "target"],
            "properties": {
              "mode": { "const": "source-subtree" },
              "source": { "$ref": "#/$defs/relative_path" },
              "target": { "$ref": "#/$defs/relative_path" }
            }
          }
        ]
      }
    },
    "artifacts": {
      "type": "array",
      "maxItems": 200,
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": ["path", "ownership", "role", "removal"],
        "properties": {
          "path": { "$ref": "#/$defs/relative_path" },
          "ownership": { "enum": ["integration-managed", "host-shared"] },
          "role": { "type": "string", "minLength": 1, "maxLength": 1000 },
          "removal": { "enum": ["candidate", "retain"] }
        },
        "allOf": [
          {
            "if": { "properties": { "ownership": { "const": "host-shared" } } },
            "then": { "properties": { "removal": { "const": "retain" } } }
          }
        ]
      }
    },
    "invariants": {
      "type": "array",
      "minItems": 1,
      "maxItems": 200,
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": ["invariant", "status", "evidence"],
        "properties": {
          "invariant": { "type": "string", "minLength": 1, "maxLength": 4000 },
          "status": { "enum": ["preserved", "not-applicable", "blocked"] },
          "evidence": { "type": "string", "minLength": 1, "maxLength": 4000 }
        }
      }
    },
    "verification": {
      "type": "array",
      "minItems": 1,
      "maxItems": 200,
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": ["scope", "check", "status", "evidence", "at"],
        "properties": {
          "scope": { "enum": ["remote", "foundation", "host", "production"] },
          "check": { "type": "string", "minLength": 1, "maxLength": 1000 },
          "status": { "enum": ["passed", "failed", "unverified"] },
          "evidence": { "type": "string", "minLength": 1, "maxLength": 4000 },
          "at": { "type": "string", "format": "date-time" }
        }
      }
    },
    "unverified": {
      "type": "array",
      "maxItems": 100,
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": ["boundary", "reason"],
        "properties": {
          "boundary": { "type": "string", "minLength": 1, "maxLength": 1000 },
          "reason": { "type": "string", "minLength": 1, "maxLength": 4000 }
        }
      }
    },
    "history": {
      "type": "array",
      "minItems": 1,
      "maxItems": 200,
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": ["action", "from_commit", "to_commit", "at", "summary"],
        "properties": {
          "action": { "enum": ["integrate", "validate", "refine", "upgrade", "remove"] },
          "from_commit": {
            "oneOf": [
              { "type": "null" },
              { "type": "string", "pattern": "^[0-9a-f]{40}$" }
            ]
          },
          "to_commit": { "type": "string", "pattern": "^[0-9a-f]{40}$" },
          "at": { "type": "string", "format": "date-time" },
          "summary": { "type": "string", "minLength": 1, "maxLength": 1000 }
        }
      }
    },
    "removal": {
      "type": "object",
      "additionalProperties": false,
      "required": ["status", "removed_paths", "retained_paths", "evidence"],
      "properties": {
        "status": { "enum": ["not-requested", "complete"] },
        "removed_paths": {
          "type": "array",
          "maxItems": 200,
          "uniqueItems": true,
          "items": { "$ref": "#/$defs/relative_path" }
        },
        "retained_paths": {
          "type": "array",
          "maxItems": 200,
          "uniqueItems": true,
          "items": { "$ref": "#/$defs/relative_path" }
        },
        "evidence": { "type": "string", "minLength": 1, "maxLength": 4000 }
      }
    },
    "updated_at": { "type": "string", "format": "date-time" }
  },
  "$defs": {
    "relative_path": {
      "type": "string",
      "maxLength": 512,
      "pattern": "^(?!/)(?!.*(?:^|/)\\.\\.?(/|$))[A-Za-z0-9._-]+(?:/[A-Za-z0-9._-]+)*$"
    }
  },
  "allOf": [
    {
      "if": { "properties": { "state": { "const": "active" } } },
      "then": {
        "properties": {
          "artifacts": { "type": "array", "minItems": 1 },
          "invariants": {
            "type": "array",
            "items": {
              "type": "object",
              "properties": {
                "status": { "enum": ["preserved", "not-applicable"] }
              }
            }
          },
          "verification": {
            "type": "array",
            "allOf": [
              {
                "items": {
                  "type": "object",
                  "properties": {
                    "status": { "enum": ["passed", "unverified"] }
                  }
                }
              },
              {
                "contains": {
                  "type": "object",
                  "required": ["scope", "status"],
                  "properties": {
                    "scope": { "const": "remote" },
                    "status": { "const": "passed" }
                  }
                }
              },
              {
                "contains": {
                  "type": "object",
                  "required": ["scope", "status"],
                  "properties": {
                    "scope": { "const": "host" },
                    "status": { "const": "passed" }
                  }
                }
              }
            ]
          },
          "removal": {
            "type": "object",
            "properties": { "status": { "const": "not-requested" } }
          }
        }
      }
    },
    {
      "if": { "properties": { "state": { "enum": ["partial", "active"] } } },
      "then": {
        "properties": {
          "removal": {
            "type": "object",
            "properties": {
              "status": { "const": "not-requested" },
              "removed_paths": { "type": "array", "maxItems": 0 }
            }
          }
        }
      }
    },
    {
      "if": { "properties": { "state": { "const": "removed" } } },
      "then": {
        "properties": {
          "removal": {
            "type": "object",
            "properties": { "status": { "const": "complete" } }
          },
          "history": {
            "type": "array",
            "contains": {
              "type": "object",
              "required": ["action"],
              "properties": { "action": { "const": "remove" } }
            }
          }
        }
      }
    }
  ]
}
