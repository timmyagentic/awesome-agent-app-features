{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://github.com/timmyagentic/awesome-agent-app-features/protocol/feedback/v1/schema.json",
  "title": "Awesome Agent App Features Feedback v1",
  "type": "object",
  "additionalProperties": false,
  "required": ["schema", "user_approved", "environment"],
  "properties": {
    "schema": { "const": 1 },
    "user_approved": { "const": true },
    "install_id": {
      "type": "string",
      "minLength": 1,
      "maxLength": 64,
      "pattern": "^[A-Za-z0-9._-]+$"
    },
    "environment": {
      "type": "object",
      "additionalProperties": false,
      "required": ["product"],
      "properties": {
        "product": { "$ref": "#/$defs/metadata" },
        "version": { "$ref": "#/$defs/metadata" },
        "os": { "$ref": "#/$defs/metadata" },
        "arch": { "$ref": "#/$defs/metadata" },
        "agent": { "$ref": "#/$defs/metadata" }
      }
    },
    "description": {
      "type": "string",
      "minLength": 1,
      "maxLength": 4000,
      "pattern": "\\S"
    },
    "recent_error": {
      "type": "object",
      "additionalProperties": false,
      "required": ["text", "occurred_at"],
      "properties": {
        "text": { "type": "string", "minLength": 1, "maxLength": 4000, "pattern": "\\S" },
        "occurred_at": { "type": "string", "format": "date-time", "maxLength": 64 }
      }
    },
    "capability_gaps": {
      "type": "array",
      "minItems": 1,
      "maxItems": 20,
      "uniqueItems": true,
      "items": { "type": "string", "minLength": 1, "maxLength": 160, "pattern": "\\S" }
    }
  },
  "anyOf": [
    { "required": ["description"], "properties": { "description": true } },
    { "required": ["recent_error"], "properties": { "recent_error": true } },
    { "required": ["capability_gaps"], "properties": { "capability_gaps": true } }
  ],
  "$defs": {
    "metadata": {
      "type": "string",
      "minLength": 1,
      "maxLength": 160,
      "pattern": "^(?=.*\\S)[^\\u0000-\\u001F\\u007F]+$"
    }
  },
  "$comment": "maxLength is structural; implementations additionally enforce the documented UTF-8 byte limits."
}
