{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://github.com/timmyagentic/awesome-agent-app-features/protocol/feedback/v2/schema.json",
  "title": "Awesome Agent App Features Feedback v2",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "schema",
    "user_approved",
    "environment",
    "report_id"
  ],
  "properties": {
    "schema": {
      "const": 2
    },
    "user_approved": {
      "const": true
    },
    "environment": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "product"
      ],
      "properties": {
        "product": {
          "$ref": "#/$defs/metadata"
        },
        "version": {
          "$ref": "#/$defs/metadata"
        },
        "os": {
          "$ref": "#/$defs/metadata"
        },
        "arch": {
          "$ref": "#/$defs/metadata"
        },
        "agent": {
          "$ref": "#/$defs/metadata"
        }
      }
    },
    "description": {
      "type": "string",
      "minLength": 1,
      "maxLength": 4000,
      "pattern": "\\S"
    },
    "recent_error": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "text",
        "occurred_at"
      ],
      "properties": {
        "text": {
          "type": "string",
          "minLength": 1,
          "maxLength": 4000,
          "pattern": "\\S"
        },
        "occurred_at": {
          "type": "string",
          "format": "date-time",
          "maxLength": 64
        }
      }
    },
    "capability_gaps": {
      "type": "array",
      "minItems": 1,
      "maxItems": 20,
      "uniqueItems": true,
      "items": {
        "type": "string",
        "minLength": 1,
        "maxLength": 160,
        "pattern": "\\S"
      }
    },
    "report_id": {
      "type": "string",
      "pattern": "^[a-f0-9]{32}$"
    },
    "diagnostic": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "capture_version",
        "started_at",
        "occurred_at",
        "phase",
        "error_code",
        "runtime",
        "transport"
      ],
      "properties": {
        "capture_version": {
          "const": 1
        },
        "started_at": {
          "type": "string",
          "format": "date-time",
          "maxLength": 64
        },
        "occurred_at": {
          "type": "string",
          "format": "date-time",
          "maxLength": 64
        },
        "phase": {
          "type": "string",
          "minLength": 1,
          "maxLength": 64,
          "pattern": "^(?=.*\\S)[^\\u0000-\\u001F\\u007F]+$"
        },
        "error_code": {
          "type": "string",
          "minLength": 1,
          "maxLength": 64,
          "pattern": "^(?=.*\\S)[^\\u0000-\\u001F\\u007F]+$"
        },
        "request": {
          "type": "string",
          "minLength": 1,
          "maxLength": 4000,
          "pattern": "\\S"
        },
        "response": {
          "type": "string",
          "minLength": 1,
          "maxLength": 1200,
          "pattern": "\\S"
        },
        "error": {
          "type": "string",
          "minLength": 1,
          "maxLength": 4000,
          "pattern": "\\S"
        },
        "runtime": {
          "type": "object",
          "additionalProperties": false,
          "required": [
            "idle_timeout_ms",
            "max_turn_time_ms"
          ],
          "properties": {
            "backend": {
              "type": "string",
              "minLength": 1,
              "maxLength": 160,
              "pattern": "^(?=.*\\S)[^\\u0000-\\u001F\\u007F]+$"
            },
            "agent_version": {
              "type": "string",
              "minLength": 1,
              "maxLength": 160,
              "pattern": "^(?=.*\\S)[^\\u0000-\\u001F\\u007F]+$"
            },
            "platform": {
              "type": "string",
              "minLength": 1,
              "maxLength": 160,
              "pattern": "^(?=.*\\S)[^\\u0000-\\u001F\\u007F]+$"
            },
            "model": {
              "type": "string",
              "minLength": 1,
              "maxLength": 160,
              "pattern": "^(?=.*\\S)[^\\u0000-\\u001F\\u007F]+$"
            },
            "effort": {
              "type": "string",
              "minLength": 1,
              "maxLength": 160,
              "pattern": "^(?=.*\\S)[^\\u0000-\\u001F\\u007F]+$"
            },
            "service_tier": {
              "type": "string",
              "minLength": 1,
              "maxLength": 160,
              "pattern": "^(?=.*\\S)[^\\u0000-\\u001F\\u007F]+$"
            },
            "mode": {
              "type": "string",
              "minLength": 1,
              "maxLength": 160,
              "pattern": "^(?=.*\\S)[^\\u0000-\\u001F\\u007F]+$"
            },
            "settings_source": {
              "type": "string",
              "minLength": 1,
              "maxLength": 160,
              "pattern": "^(?=.*\\S)[^\\u0000-\\u001F\\u007F]+$"
            },
            "idle_timeout_ms": {
              "type": "integer",
              "minimum": 0,
              "maximum": 2592000000
            },
            "max_turn_time_ms": {
              "type": "integer",
              "minimum": 0,
              "maximum": 2592000000
            }
          }
        },
        "transport": {
          "type": "object",
          "additionalProperties": false,
          "required": [],
          "properties": {
            "process_state": {
              "type": "string",
              "minLength": 1,
              "maxLength": 64,
              "pattern": "^(?=.*\\S)[^\\u0000-\\u001F\\u007F]+$"
            },
            "read_state": {
              "type": "string",
              "minLength": 1,
              "maxLength": 64,
              "pattern": "^(?=.*\\S)[^\\u0000-\\u001F\\u007F]+$"
            },
            "last_protocol_ms": {
              "type": "integer",
              "minimum": 0,
              "maximum": 2592000000
            },
            "last_core_ms": {
              "type": "integer",
              "minimum": 0,
              "maximum": 2592000000
            },
            "last_delivery_ms": {
              "type": "integer",
              "minimum": 0,
              "maximum": 2592000000
            },
            "pending_rpc": {
              "type": "integer",
              "minimum": 0,
              "maximum": 1000000000
            },
            "queue_depth": {
              "type": "integer",
              "minimum": 0,
              "maximum": 1000000000
            },
            "queue_high_water": {
              "type": "integer",
              "minimum": 0,
              "maximum": 1000000000
            },
            "dropped_events": {
              "type": "integer",
              "minimum": 0,
              "maximum": 1000000000
            },
            "terminal_received": {
              "type": "boolean"
            },
            "terminal_delivered": {
              "type": "boolean"
            },
            "exit_code": {
              "type": "integer",
              "minimum": -65535,
              "maximum": 65535
            }
          }
        },
        "activity": {
          "type": "array",
          "minItems": 1,
          "maxItems": 24,
          "items": {
            "type": "object",
            "additionalProperties": false,
            "required": [
              "after_ms",
              "kind"
            ],
            "properties": {
              "after_ms": {
                "type": "integer",
                "minimum": 0,
                "maximum": 2592000000
              },
              "kind": {
                "type": "string",
                "minLength": 1,
                "maxLength": 64,
                "pattern": "^(?=.*\\S)[^\\u0000-\\u001F\\u007F]+$"
              },
              "name": {
                "type": "string",
                "minLength": 1,
                "maxLength": 96,
                "pattern": "^(?=.*\\S)[^\\u0000-\\u001F\\u007F]+$"
              }
            }
          }
        },
        "missing": {
          "type": "array",
          "minItems": 1,
          "maxItems": 24,
          "uniqueItems": true,
          "items": {
            "type": "string",
            "minLength": 1,
            "maxLength": 160,
            "pattern": "^(?=.*\\S)[^\\u0000-\\u001F\\u007F]+$"
          }
        },
        "truncated": {
          "type": "array",
          "minItems": 1,
          "maxItems": 24,
          "uniqueItems": true,
          "items": {
            "type": "string",
            "minLength": 1,
            "maxLength": 160,
            "pattern": "^(?=.*\\S)[^\\u0000-\\u001F\\u007F]+$"
          }
        }
      }
    }
  },
  "anyOf": [
    {
      "required": [
        "description"
      ],
      "properties": {
        "description": true
      }
    },
    {
      "required": [
        "recent_error"
      ],
      "properties": {
        "recent_error": true
      }
    },
    {
      "required": [
        "capability_gaps"
      ],
      "properties": {
        "capability_gaps": true
      }
    }
  ],
  "$defs": {
    "metadata": {
      "type": "string",
      "minLength": 1,
      "maxLength": 160,
      "pattern": "^(?=.*\\S)[^\\u0000-\\u001F\\u007F]+$"
    }
  },
  "$comment": "maxLength is structural; implementations additionally enforce the documented UTF-8 byte limits."
}
