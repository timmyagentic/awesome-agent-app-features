{
  "name": "awesome-agent-app-features-feedback-relay",
  "version": "0.0.0-unreleased",
  "private": true,
  "type": "module",
  "scripts": {
    "check": "node --check src/index.js && node --check src/relay.js && node --check test/index.test.js && node --check test/runtime.spec.js && node --check vitest.config.js",
    "test": "npm run test:unit && npm run test:runtime",
    "test:unit": "node --test test/index.test.js",
    "test:runtime": "vitest run --config vitest.config.js",
    "typecheck": "tsc --noEmit",
    "types": "wrangler types worker-configuration.d.ts --include-runtime=false",
    "types:check": "wrangler types worker-configuration.d.ts --include-runtime=false --check",
    "validate:worker": "wrangler deploy --dry-run --outdir .wrangler/dry-run"
  },
  "engines": {
    "node": ">=22"
  },
  "devDependencies": {
    "@cloudflare/vitest-plugin": "^1.1.2",
    "@cloudflare/workers-types": "^5.20260830.1",
    "@types/node": "^26.4.0",
    "ajv": "8.20.0",
    "ajv-formats": "3.0.1",
    "typescript": "^7.0.2",
    "vitest": "^4.1.11",
    "wrangler": "^4.127.1"
  }
}
